// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ----------------------------------------------------------------
// MODELS
// ----------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  role          String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  enrollments   Enrollment[]
  orders        Order[]
  progress      LessonProgress[]
  reviews       Review[]
  quizAttempts  QuizAttempt[]
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  parentId    String?
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToCategory")
  documents   Document[]
  quizzes     Quiz[]
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  documents Document[] @relation("DocumentTags")
}

model Document {
  id          String   @id @default(cuid())
  title       String
  description String?
  filePath    String
  fileType    String
  coverImage  String?
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category @relation(fields: [categoryId], references: [id])
  tags        Tag[]    @relation("DocumentTags")
}

model Course {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  description     String?
  thumbnail       String?
  price           Float
  originalPrice   Float?
  status          String   @default("draft") // draft, published
  validityPeriod  Int?     // Number of days, null or 0 means lifetime
  level           String?  // HSK 1, HSK 2, HSKK
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sections        CourseSection[]
  enrollments     Enrollment[]
  orderItems      OrderItem[]
  reviews         Review[]
}

model CourseSection {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  orderIndex  Int      @default(0)

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
}

model Lesson {
  id          String     @id @default(cuid())
  sectionId   String
  title       String
  content     String?    // Text or rich text content
  videoUrl    String?
  duration    Int?       // in seconds
  lessonType  String    @default("VIDEO") // VIDEO | PDF | QUIZ | TEXT
  isPreview   Boolean    @default(false)
  orderIndex  Int        @default(0)
  quizId      String?    // Link to Quiz if lessonType = QUIZ

  section     CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  quiz        Quiz?      @relation(fields: [quizId], references: [id])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  progress    Float     @default(0.0) // 0 to 100 percentage
  enrolledAt  DateTime  @default(now())
  expiresAt   DateTime? // Computed from course.validityPeriod

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  total         Float
  status        String    @default("PENDING")
  paymentMethod String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id])
  items         OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  courseId  String
  price     Float

  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course    Course @relation(fields: [courseId], references: [id])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  watchTime   Int       @default(0) // Seconds watched for video
  completedAt DateTime?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int      // 1 to 5
  comment   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------
// QUIZ / INTERACTIVE LEARNING SYSTEM
// ----------------------------------------------------------------

model Quiz {
  id          String    @id @default(cuid())
  title       String
  description String?
  level       String?   // HSK 1, HSK 2, HSK 3...
  quizType    String    @default("EXERCISE") // EXERCISE | MOCK_EXAM
  timeLimit   Int?      // Minutes, null = no limit
  status      String    @default("draft") // draft | published
  categoryId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  questions   Question[]
  attempts    QuizAttempt[]
  category    Category? @relation(fields: [categoryId], references: [id])
  lessons     Lesson[]
}

model Question {
  id            String   @id @default(cuid())
  quizId        String
  questionType  String   // MULTIPLE_CHOICE | FILL_IN_BLANK | MATCHING | WORD_ORDER | TONE_RECOGNITION
  question      String   // Question text (supports plain text with ___ for blanks)
  explanation   String?  // Explanation shown after answering
  audioUrl      String?  // Audio URL for listening/tone exercises
  imageUrl      String?  // Illustration image
  orderIndex    Int      @default(0)
  points        Int      @default(1)

  // For FILL_IN_BLANK: correct answers stored in choices with isCorrect=true
  // For MATCHING: pairs stored as choices with orderIndex for left/right grouping
  // For WORD_ORDER: correct order stored as explanation; shuffled words as choices
  // For TONE_RECOGNITION: correct tone stored as choice with isCorrect=true

  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  choices       QuestionChoice[]
  userAnswers   UserAnswer[]
}

model QuestionChoice {
  id          String   @id @default(cuid())
  questionId  String
  content     String   // Choice text / word / match pair part
  isCorrect   Boolean  @default(false)
  matchGroup  String?  // For MATCHING: "left" or "right"
  orderIndex  Int      @default(0)

  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id           String    @id @default(cuid())
  userId       String
  quizId       String
  score        Float?    // 0-100 percentage
  totalPoints  Int       @default(0)
  earnedPoints Int       @default(0)
  status       String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  timeSpent    Int?      // Seconds

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz         Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers      UserAnswer[]
}

model UserAnswer {
  id          String   @id @default(cuid())
  attemptId   String
  questionId  String
  answer      String   // JSON for matching/word_order, plain text for fill_in_blank, choice id for MCQ
  isCorrect   Boolean  @default(false)

  attempt     QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}
